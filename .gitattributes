# Normalize line endings: LF in repo and worktrees, no CRLF churn across OSes.
* text=auto

# Force LF for anything executable or machine-parsed
*.sh        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.tsv       text eol=lf
*.py        text eol=lf

# Docs and skills: text, LF
*.md        text eol=lf
*.txt       text eol=lf

# Binary opt-outs (never normalize)
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.pdf       binary
